# Values a throwaway Molecule container needs so provisioning can finish.
#
# Loaded FIRST in every scenario's `env_files`, so a real `.env.testing` or
# `.env.production` overrides every line here -- the merge takes the last file
# to give a key a value. A key left blank does NOT override, which is what
# keeps `website/.env.example` (blank on purpose, loaded last by the ci
# scenario) from undoing this file; see `converge.yml`.
#
# Why this file exists at all: `manage.py migrate` aborts on a Django system
# check of level ERROR, and `asastats.E001` fires when SIMPLE_JWT_KEY is empty.
# The committed `website/.env.example` deliberately leaves it blank ("ROTATED --
# never reuse the old hardcoded value"), which is right for an example and
# fatal for provisioning, so the value a container needs lives here instead of
# being written into the example.
#
# Nothing here is a secret and nothing here should ever reach a real host.

# Signs and verifies only within the container. An empty value makes
# `manage.py` refuse to run at all; a wrong one is harmless because no real
# token is presented to this host.
SIMPLE_JWT_KEY=molecule-provisioning-only-not-a-secret

# Silences asastats.W003. Not required to provision -- it is a Warning, not an
# Error -- but a warning nobody can act on is one everybody learns to ignore.
EXPORT_TIERS_ADDRESSES_LIMIT=free:5,Intro:6,Asastatser:7,Professional:8,Cluster:10
