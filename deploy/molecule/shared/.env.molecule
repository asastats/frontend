# Defaults for a throwaway Molecule container, loaded FIRST in every scenario so a
# real `.env.testing`/`.env.production` overrides them; a blank value never
# overrides (see `converge.yml`). Nothing here is a secret or reaches a real host.
# docs/logbook.md#deploymoleculesharedenvmolecule-long-comments-2026-10-31

# Signs and verifies only within the container. An empty value makes
# `manage.py` refuse to run at all; a wrong one is harmless because no real
# token is presented to this host.
SIMPLE_JWT_KEY=molecule-provisioning-only-not-a-secret

# Silences asastats.W003. Not required to provision -- it is a Warning, not an
# Error -- but a warning nobody can act on is one everybody learns to ignore.
EXPORT_TIERS_ADDRESSES_LIMIT=free:5,Intro:6,Asastatser:7,Professional:8,Cluster:10
