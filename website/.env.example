# ===========================================================================
# frontend — environment template
# ===========================================================================

# --- Django ---
SECRET_KEY=
SIMPLE_JWT_KEY=                     # ROTATED — never reuse the old hardcoded value

# --- Database (this app's own Postgres: users, profiles, bundles) ---
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
PGPASSFILE=/home/youruser/.pgpass   # optional; libpq passfile path (host-specific)

REDIS_AUTH=

# --- Project information ---
WEBSITE_NAME=
WEBSITE_SHORT_NAME=
WEBSITE_URL=
WEBSITE_DOMAIN=
WEBSITE_BASE_DOMAIN=
X_HANDLE=
SUBREDDIT_NAME=
ANDROID_APP=
IOS_APP=
MEDIUM_NAME=
DISCORD_INVITE=
GITHUB_ORGANIZATION=

# --- ASA Stats backend (the engine boundary over HTTP) ---
ASASTATS_API_URL=https://api.asastats.com
ASASTATS_API_KEY=
ASASTATS_API_TIMEOUT=30

# --- Algorand access (public nodes for forks; private for the main site) ---
# Still needed by the OPEN app to read the on-chain permission dApp (Gate B),
# NOT for portfolio data.
ALGOD_URL=https://mainnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://mainnet-idx.algonode.cloud
INDEXER_TOKEN=

WALLET_CONNECT_PROJECT_ID=
EXPORT_TIERS_ADDRESSES_LIMIT=

# --- OAuth / integrations ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DISCORD_APPLICATION_ID=
DISCORD_SECRET=
DISCORD_PUBLIC_KEY=
TWITTER_CLIENT_ID=
TWITTER_SECRET=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- User widgets ---
WIDGETS_API_TOKEN=
FOLKS_REFERRER_ADDRESS=
HAYSTACK_API_KEY=
HAYSTACK_REFERRER_ADDRESS=

# Web push, for the alerts widget. Generate a pair with the recipe in
# post-deploy/RUN-vapid-keys.md - note that Vapid01 has no
# `public_key_urlsafe_base64()`; the keys have to be serialised explicitly.
#
# The private key signs and must never leave deploy/.env.production. The public
# one is served to the browser and is bound into every subscription, so changing
# the pair invalidates all of them and every reader has to re-enable alerts.
# VAPID_ADMIN_EMAIL is the contact the push services require, as mailto:you@…
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# Shared with the engine, which signs the body of every "this page was
# re-priced" call with it. Any long random string; both sides must hold the
# same one, and the engine's copy lives in its own environment.
#
# **Leaving it empty does not disable the check - it refuses every call.** An
# empty secret that meant "skip" would be an endpoint anybody could post rule
# firings to, so alerts simply never fire until this is set on both sides.
ALERTS_WEBHOOK_SECRET=
